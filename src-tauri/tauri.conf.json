{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "vtjs",
	"version": "5.0.3",
	"identifier": "com.vtjs.app",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "VTJS",
				"width": 1280,
				"height": 1024,
				"shadow": true,
				"minimizable": true,
				"decorations": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"windows": {
				"installMode": "passive"
			},
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0RkJBQjVFMzE1NDZBMzEKUldReGFsUXhYcXY3NUJ4SmJjZllNcTMvdC9RRm1iUUtrMmVLVEFiL1VvRHdKU2FlelJaMHR4QVEK",
			"endpoints": ["https://github.com/tsecret/vtjs/releases/latest/download/latest.json"]
		}
	}
}
